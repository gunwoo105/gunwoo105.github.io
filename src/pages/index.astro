---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
---
<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> A LITTLE SPACE ON THE INTERNET</p><h1 id="hero-title">생각을 코드로,<br /><em>배움을 기록으로.</em></h1><p class="hero-description">안녕하세요, 건우입니다.<br />개발하며 발견한 것들과 작은 배움의 순간을 기록합니다.</p><a class="text-link" href="#posts">기록 살펴보기 <span aria-hidden="true">↘</span></a></div>
    <div class="hero-art" aria-hidden="true"><div class="art-grid"></div><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="art-core"><span>g.</span></div><span class="art-label art-label-top">NOTES ON<br />BUILDING THINGS</span><span class="art-label art-label-bottom">EST. 2026<br />ONLINE, ANYWHERE</span><span class="art-cross">✳</span></div>
    <div class="hero-bottom"><span>GUNWOO'S DIGITAL GARDEN</span><span>SCROLL TO EXPLORE ↓</span></div>
  </section>
  <section class="journal" id="posts" aria-labelledby="posts-title">
    <div class="section-heading"><div><p class="eyebrow">THE JOURNAL <span class="eyebrow-line"></span> {String(posts.length).padStart(2, '0')} ENTRIES</p><h2 id="posts-title">최근 기록<span>.</span></h2><p>차곡차곡 쌓아가는 생각과 배움</p></div><span class="section-side">WRITTEN WITH CURIOSITY ✳</span></div>
    {tags.length > 0 && <div class="tag-list" aria-label="주제별 글"><span class="tag-label">TOPICS</span>{tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}># {tag}</a>)}</div>}
    <PostList posts={posts} />
  </section>
  <section class="about-banner"><div><p class="eyebrow">A NOTE FROM ME</p><h2>좋은 질문에서<br /><em>좋은 기록이 시작됩니다.</em></h2><p>궁금한 것을 탐색하고, 알게 된 것을 나눕니다.</p></div><a href="/about/" class="round-link" aria-label="블로그 소개 읽기">↗</a></section>
</BaseLayout>
