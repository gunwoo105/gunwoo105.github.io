---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '../../lib/posts';
export async function getStaticPaths() {
  return (await getPublishedPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}><article class="article-page"><a class="back-link" href="/#posts">← 모든 기록</a><header class="article-header"><div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span class="meta-divider">/</span><span>{post.data.tags.join(' · ')}</span></div><h1>{post.data.title}</h1><p>{post.data.description}</p></header><div class="prose"><Content /></div><div class="article-end"><span>✳</span><p>읽어주셔서 감사합니다.</p><a href="/#posts">다른 기록 보기 ↗</a></div></article></BaseLayout>
