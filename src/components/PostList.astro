---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postUrl } from '../lib/posts';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
---
{posts.length ? <div class="post-list">{posts.map((post, index) => <article class="post-row" data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}><span class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div class="post-content"><div class="post-category">{post.data.tags[0] || '기록'}</div><h3><a href={postUrl(post)}>{post.data.title}</a></h3><p>{post.data.description}</p><div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div></div><a class="post-arrow" href={postUrl(post)} aria-label={`${post.data.title} 읽기`}>↗</a></article>)}</div> : <p class="empty-state">아직 발행된 글이 없습니다. 첫 번째 기록을 기다려 주세요.</p>}
