---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title, description = '배우고 만들며 기록하는 공간, 건우의 개발 블로그입니다.' } = Astro.props;
const pageTitle = title ? `${title} | gunwoo.log` : 'gunwoo.log — 배우고, 만들고, 기록합니다';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="theme-color" content="#f7f8f4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" /><meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="gunwoo.log 홈"><span class="brand-mark">g<span>.</span></span><span>gunwoo<span class="brand-dot">.</span>log</span></a>
        <nav aria-label="주 메뉴"><a href="/#posts">글 목록</a><a href="/about/">소개</a><a class="github-link" href="https://github.com/gunwoo105" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><div><a class="footer-brand" href="/">gunwoo<span>.</span>log</a><p>배우고, 만들고, 기록합니다.</p></div><div class="footer-right"><a href="https://github.com/gunwoo105" target="_blank" rel="noopener noreferrer">GitHub ↗</a><p>© {new Date().getFullYear()} gunwoo105</p></div></footer>
    </div>
  </body>
</html>
